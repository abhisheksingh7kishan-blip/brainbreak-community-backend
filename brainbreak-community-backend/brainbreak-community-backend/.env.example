# Copy this file to `.env.local` for local development with `vercel dev`.
# In production, set these in the Vercel dashboard instead:
# Project -> Settings -> Environment Variables.
#
# All three come from Supabase -> Project Settings -> API.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# SECRET — server-only. Never expose this to the game client, never commit
# a real value to git. Only used by api/_lib/supabaseClients.js's
# serviceClient(), for the two backend-only operations (achievement sync,
# leaderboard cache refresh).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
